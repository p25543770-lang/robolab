{
    // F5 запускает ОТКРЫТЫЙ файл robot.py на компьютере (робот не нужен,
    // на ПК программа просто печатает подсказку и не падает).
    // На самом кирпиче файл обновляется сам: при каждом запуске
    // MODE = 'run' он проверяет GitHub, скачивает свежий robot.py и
    // сразу едет уже новым кодом. Заливать руками нужно только один раз.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "robot.py (запуск на компьютере)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "robot.py: проверить, есть ли обновление (ничего не меняет)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/robot.py",
            "args": ["--update-check"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "robot.py: обновить файл с GitHub",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/robot.py",
            "args": ["--update"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Компьютер: симулятор полигона",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/sim.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Компьютер: стресс-тест линии",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/stress.py",
            "console": "integratedTerminal"
        }
    ]
}
