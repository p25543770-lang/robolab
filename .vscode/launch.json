{
    // Запуск по F5. Прошивка у вас ev3dev (команда brickrun),
    // поэтому РАБОЧАЯ конфигурация - первая:
    //   "EV3 (ev3dev): залить и запустить"
    // Она копирует robot.py на кирпич по SSH и запускает его там командой brickrun.
    // Пароль кирпича ev3dev по умолчанию: maker
    //
    // Конфигурации с pybricksdev оставлены только для прошивки Pybricks:
    // на ev3dev они падают с ошибкой "usb.core.NoBackendError: No backend available".
    "version": "0.2.0",
    "configurations": [
        {
            "name": "EV3 (ev3dev): залить и запустить",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/upload.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "EV3 (ev3dev): залить и проверить датчики",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/upload.py",
            "args": ["--check"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "EV3 (ev3dev): только залить (без запуска)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/upload.py",
            "args": ["--no-run"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "EV3 (ev3dev): обновить программу с GitHub",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/upload.py",
            "args": ["--update"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Компьютер: симулятор полигона",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/sim.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Компьютер: стресс-тест линии",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/stress.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Pybricks (только для прошивки Pybricks): залить по USB",
            "type": "debugpy",
            "request": "launch",
            "module": "pybricksdev",
            "args": ["run", "usb", "${workspaceFolder}/robot.py"],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
